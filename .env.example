# Скопируй в .env и заполни.

# Токен бота от @BotFather. TG_CHAT_ID оставь пустым: бот запишет его сам после первого /start в личном чате с ним.
# Владелец — только личный чат (id = твой Telegram user id): в группе или канале команды владельца не работают.
TG_TOKEN=
TG_CHAT_ID=
# Гости через запятую (id чатов): получают сигналы и /best /top /calc /banks /maker /fees /history,
# но не настройки, ключи и журнал. Добавлять командами /allow <id> или /allow @ник (доступ откроется с первого
# сообщения этого пользователя боту) и /deny — бот сам пишет сюда.
TG_GUESTS=

EXCHANGES=bybit,mexc,htx,kucoin,bitpapa,bestchange
# Монеты за рубли. Связки P2P<->спот идут через USDT (одна спот-конвертация).
# EXCHANGES/ASSETS можно менять кнопками ⚙️ Настройки → 🎛 Фильтры (нельзя выключить всё); там же пресеты.
ASSETS=USDT,USDC,BTC,ETH,TON
FIAT=RUB
# Только связки внутри одной площадки, без переводов между биржами (пресет «USDT без переводов»)
SAME_VENUE_ONLY=0
# Сумма одного круга, руб.
AMOUNT=50000
# Порог сигнала, % чистыми
MIN_PROFIT=2.0
# Секунды между сканами USDT. Меньше 10 — риск бана по IP.
INTERVAL=10
# Секунды между опросами остальных монет
ALT_INTERVAL=60
# Секунды между скачиваниями выгрузки BestChange (~16 МБ)
BC_REFRESH=120
# Если весь трафик ПК идёт через VPN и BestChange его IP не отвечает: бот сам пробует выгрузку с локальных адресов ПК
# (в обход VPN) и запоминает рабочий. Здесь можно задать такой адрес вручную (например, 192.168.1.104).
BC_LOCAL_ADDR=
# Фильтр мерчантов: мин. сделок за месяц и % завершённых
MIN_ORDERS=50
MIN_RATE=95
# Цена дальше ±N% от биржевого курса = аномалия (грязные деньги/скам), отсев
MAX_DEV=4
# Комиссия вывода для бирж без своей таблицы (у Bybit/MEXC — по сетям в p2p.py WITHDRAW), в монете
TRANSFER_FEES=USDT:1,USDC:1,BTC:0.0002,ETH:0.001,TON:0.05
# Комиссия спота по биржам, %
SPOT_FEES=Bybit:0.1,MEXC:0.1,HTX:0.2,KuCoin:0.1
# Запас на движение курса волатильных монет, пока идут сделки и переводы, %
RISK_BUFFER=BTC:0.3,ETH:0.5,TON:0.7
# Комиссия банка за оплату продавцу, % (СБП другим бесплатно до 100 тыс./мес в каждом банке, дальше до 0.5%)
PAY_FEE=0
# Штраф в п.п. профита за каждую причину риска (см. метку надёжности) при сортировке связок
RISK_PENALTY=1.5
# Только эти способы оплаты (подстроки через запятую), пусто = все
INCLUDE_PAY=
EXCLUDE_PAY=mobile top-up,cash,наличн,чат,chat,api,qr
# Антиспам: не больше N сигналов за скан; повтор по той же паре через COOLDOWN сек,
# раньше — только если профит вырос на REPEAT_STEP п.п.
MAX_SIGNALS=3
COOLDOWN=1800
REPEAT_STEP=0.3
# Сигнал только если связка держится ≥ N сканов подряд (1 = сразу). Отсеивает минутные выбросы.
LIVE_SCANS=2
# Кнопки нового Bot API под карточкой: зелёная «Купить» / красная «Продать» и «📋» — скопировать сумму и объём.
# 0 = обычные кнопки. Если сервер Telegram их не примет, бот сам перейдёт на обычные.
FANCY_BUTTONS=1

# Тихие часы (МСК, формат ЧЧ:ММ-ЧЧ:ММ, можно через полночь, напр. 23:00-07:00): в это окно сигналы
# не шлются, а копятся; по окончании — один дайджест с топ-3 связками за ночь. Включаются кнопкой
# «🌙 Тихие часы» в ⚙️ Настройки (она же пишет QUIET_HOURS_ON) — само окно задаётся только здесь.
QUIET_HOURS=01:00-08:00
QUIET_HOURS_ON=0

# Ссылка на облачные запуски для кнопки «🛠 Разработка»
ROUTINE_URL=

# Сухой прогон (paper trading): виртуальные круги без реальных денег — бот только записывает,
# что сделал бы сам, и сравнивает план с тем, что получилось бы на самом деле (data/paper.db).
# 0 = выключен. Запуск круга по сигналу и проверка стадий — в следующих задачах очереди.
PAPER=0
PAPER_AMOUNT=10000
# Сколько минут «идёт» оплата рублями / перевод монеты до проверки следующей стадии
PAPER_PAY_MINUTES=5
PAPER_TRANSFER_MINUTES=3
# Не больше N виртуальных кругов одновременно
PAPER_MAX_OPEN=1

# Бумажный мейкер (simmaker.py, data/sim_maker.db): симуляция СВОИХ объявлений по снимкам стакана — реальных
# объявлений бот не создаёт и к бирже не обращается. Исполнения — слабый прокси (убыль объёма у конкурентов с ценой
# не хуже нашей между сканами). Отчёт — /maker paper (только владельцу). 0 = выключен.
SIM_MAKER=0
SIM_MAKER_EX=Bybit
SIM_MAKER_ASSETS=USDT
# Стороны: buy — объявление на покупку монеты, sell — на продажу
SIM_MAKER_SIDES=buy,sell
# Лот объявления в ₽ (пусто — сумма круга AMOUNT) и предел позиции в лотах
SIM_MAKER_AMOUNT=
SIM_MAKER_MAX_LOTS=1
# Коридор цены, ±% от ориентира; спред круга после комиссии, %, ниже которого новую позицию не набираем
SIM_MAKER_BAND=2
SIM_MAKER_MIN_SPREAD=0
# Доля прокси-потока, которая досталась бы нам на 1-м месте (на N-м — в N раз меньше); сек разрыва между сканами,
# после которого интервал не оцениваем
SIM_MAKER_CAPTURE=0.5
SIM_MAKER_MAX_GAP=180

# Снимки сканов для разбора и replay.py (data/snapshots.db, хранятся 14 дней): пишется каждый N-й скан
# (SNAPSHOT_EVERY, при INTERVAL=10 и 3 — раз в 30 с; скан старта круга сухого прогона — всегда) и не больше
# SNAPSHOT_MAX_MB — сверх него удаляются самые старые снимки. Снимок всех площадок и монет — ~21–26 КБ, т. е.
# ~57–71 МБ в сутки при настройках ниже: 14 дней — ~0.8–1 ГБ, лимит 1500 МБ — с запасом. 0 = снимки не писать.
SNAPSHOT_EVERY=3
SNAPSHOT_MAX_MB=1500

# Публичные данные бессрочных фьючерсов Bybit и BingX (perp.py) для бумажных симуляций ниже: только GET без ключей,
# ордеров нет. 0 = не опрашивать (хедж, фандинг и тренд на бумаге тогда тоже стоят).
PERPS=1
# Секунды между опросами перпов (не меньше 10)
PERP_INTERVAL=30
# Монеты бота; символ на площадке — по таблице perp.py (TON → Bybit GRAMUSDT, BingX GRAMTON-USDT)
PERP_ASSETS=BTC,ETH,TON
# Тейкер перпа, % (напр. Bybit:0.055,BingX:0.05); пусто — Bybit 0.055, BingX — из справочника контрактов
PERP_TAKER_FEES=
# Сколько секунд котировка перпа считается свежей
PERP_MAX_AGE=90

# Бумажный хедж кругов сухого прогона шортом перпа (simperp.py, колонки hedge_* в data/paper.db), ордеров нет.
# Итог — в /paper report. 0 = выключен.
PAPER_HEDGE=1
# 1 — план круга со стоимостью хеджа и остаточным запасом вместо запаса на курс RISK_BUFFER
HEDGE_PLAN=0
# Шорт к объёму монеты круга (1.0 — весь объём)
HEDGE_RATIO=1.0
# Допуск коэффициента после округления до лота: площадка вне HEDGE_RATIO ± N не берётся
HEDGE_RATIO_BAND=0.1
# Через сколько часов шорт закрывается, даже если круг ещё идёт
HEDGE_MAX_HOURS=6
# Остаточный запас на курс USDT/RUB при хедже, % суммы круга
HEDGE_RESIDUAL=0.1
# Сколько минут в среднем идёт круг — для оценки фандинга в плане хеджа
HEDGE_HOLD_MINUTES=40
# Какие монеты круга хеджировать
HEDGE_ASSETS=BTC,ETH,TON

# Бумажный арбитраж фандинга (simfunding.py, data/sim_funding.db): перп–перп Bybit↔BingX и спот + шорт перпа Bybit,
# ордеров нет. Отчёт — /funding (только владельцу). 0 = выключен.
SIM_FUNDING=1
# Монеты для арбитража фандинга
FUND_ASSETS=BTC,ETH,TON
# Размер позиции, USDT на ногу
FUND_NOTIONAL=1000
# Вход от этой доходности ставки (разницы ставок), % годовых
FUND_ENTRY_APR=20
# Выход после расчёта, если доходность упала ниже, % годовых
FUND_EXIT_APR=5
# Вход и выход (комиссии + спред) должны окупиться текущей ставкой не дольше, часов
FUND_PAYBACK_HOURS=48
# Наибольший разрыв цен ног при входе, %
FUND_MAX_BASIS=0.3
# Стоп: MTM позиции хуже −N% номинала
FUND_STOP=1.0
# Наибольший срок позиции, дней
FUND_MAX_DAYS=14
# Не больше N открытых позиций
FUND_MAX_OPEN=2
# Тейкер спота Bybit, %
FUND_SPOT_FEE=0.1

# Бумажная направленная стратегия (simdirectional.py, data/sim_directional.db): EMA 20/100 на 1ч свечах перпа Bybit
# со стопом по ATR и случайные входы для сравнения, ордеров нет. Отчёт — /futures (только владельцу). 0 = выключена.
SIM_DIRECTIONAL=1
# Монеты стратегии (позиция одна на все)
DIR_ASSETS=BTC,ETH
# Риск на сделку, USDT: объём = риск / расстояние до стопа
DIR_RISK_USDT=2
# Наибольший номинал позиции, USDT
DIR_MAX_NOTIONAL=200
# Стоп: ATR(14) × N от цены входа
DIR_ATR_MULT=2
# Вход не позже N секунд после закрытия свечи с сигналом
DIR_ENTRY_LAG=900
# Случайные входы (база сравнения): вероятность входа на каждой свече
DIR_RANDOM_P=0.02
# Срок случайной позиции, часов, пока у стратегии нет закрытых сделок (потом — её средний)
DIR_RANDOM_HOLD_H=48
# Проскальзывание стопа, пропущенного между опросами (закрытие по high/low свечи), %
DIR_STOP_SLIP=0.05
# Множитель комиссии тейкера в итогах (2 — как в бэктесте research/directional_bt.py; /futures показывает и ×1)
DIR_FEE_MULT=2

# Ключи бирж ТОЛЬКО НА ЧТЕНИЕ (без торговли и вывода), с белым списком IP. Пусто = функции аккаунтов выключены.
# Удобнее подключать кнопками «⚙️ Настройки → 🔑 Мои биржи» (бот сам сохранит их в data/keys.json и сразу
# удалит сообщение с ключом из чата) — эти переменные нужны только для ручного варианта без кнопок.
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
# Ключ с правами сверх чтения (торговля/вывод) бот по умолчанию удаляет. 1 — оставить по твоему решению:
# бот всё равно делает только запросы на чтение, но при утечке ключа им можно торговать или выводить.
ALLOW_UNSAFE_KEYS=0
HTX_API_KEY=
HTX_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
BINGX_API_KEY=
BINGX_API_SECRET=
# Cryptomus: ключей «только чтение» у него нет — бот оставит ключ только при ALLOW_UNSAFE_KEYS=1.
# CRYPTOMUS_API_KEY — ID кабинета (User ID или Merchant ID, UUID), CRYPTOMUS_API_SECRET — его API key (не Payout key).
CRYPTOMUS_API_KEY=
CRYPTOMUS_API_SECRET=
# Выплаты Cryptomus (/payout, решение владельца 2026-09-26): только с бизнес-кошелька и только на адреса из белого
# списка data/payout_whitelist.json (правится на ПК: python scripts/payout_whitelist.py add|list|remove); каждую
# выплату подтверждаешь кнопкой. PAYOUTS=1 — выплаты включены. Включить можно только здесь (и перезапустить бота),
# из Telegram — только выключить («⛔ Стоп выплаты» пишет сюда PAYOUTS=0). Действует только строка в этом файле:
# PAYOUTS=1 из переменных окружения Windows выплаты не включит.
PAYOUTS=0
# Лимиты в USDT-эквиваленте списания (сумма + комиссия Cryptomus): одна выплата и сумма за календарный день МСК.
# Перед самой отправкой бот заново берёт курс монеты к USDT и проверяет лимиты по нему.
PAYOUT_MAX_ONE=2000
PAYOUT_DAILY_LIMIT=2000
# Допустимый сдвиг этого курса (в %) между предпросмотром и отправкой: сдвинулся больше — выплата не уходит, её надо
# подтвердить заново с новой оценкой (/payout). Стейблкоинов (USDT, USDC) не касается. Не число — 0: любой сдвиг — отказ.
PAYOUT_RATE_DRIFT=2
# Ключ выплат бизнес-кабинета: CRYPTOMUS_PAYOUT_API_KEY — Merchant ID, CRYPTOMUS_PAYOUT_API_SECRET — Payout key.
# Только здесь, в Telegram его не присылать. После генерации Payout key Cryptomus на 24 ч блокирует выводы.
CRYPTOMUS_PAYOUT_API_KEY=
CRYPTOMUS_PAYOUT_API_SECRET=
# Секунды между опросами истории подключённых аккаунтов (депозиты/выводы/спот-сделки) для уведомлений
ACCOUNT_POLL_INTERVAL=60
